{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=procurelive;Username=procurelive_user;Password=change-me-strong-password",
    "Redis": "localhost:6379"
  },
  "JwtSettings": {
    "Issuer": "ProcureLive",
    "Audience": "ProcureLiveClient",
    "SecretKey": "REPLACE-WITH-A-STRONG-SECRET-VIA-USER-SECRETS-OR-ENV-VAR-MIN-32-CHARS",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "InitialAdmin": {
    "Email": "admin@procurelive.local",
    "Password": "ChangeMe123!"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/procurelive-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "Features": {
    "ErpIntegration": false
  }
}
